{
  // Core
  "cli_default_open_behavior": "new_window",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "auto_update": false,

  // UI
  "edit_predictions": null,
  "semantic_tokens": "combined",
  "theme": {
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
  "icon_theme": {
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "ui_font_size": 18,
  "terminal": {
    "font_family": ".ZedMono",
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
  },
  "project_panel": {
    "dock": "left",
  },

  // Collab
  "calls": {
    "mute_on_join": false,
  },

  // Buffers
  "buffer_font_size": 14,
  "buffer_font_features": {
    "calt": false,
  },
  "show_edit_predictions": false,
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },

  // Vim
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "always",
    "cursor_shape": {
      "visual": "underline",
    },
  },
  "theme_overrides": {
    "Ayu Dark": {
      "syntax": {
        "attribute.special": {
          "color": "#ff0000",
        },
      },
    },
  },
  "which_key": {
    "enabled": true,
    "delay_ms": 250,
  },

  // LSP
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
    "css-variables": {
      "settings": {
        "cssVariables": {
          "lookupFiles": ["**/*.css", "**/*.html", "**/*.svelte"],
        },
      },
    },
  },
}
