{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "permissions": [
    { "action": "external_directory", "resource": "~/go/pkg/mod/**", "effect": "allow" },
    { "action": "edit", "resource": "~/go/pkg/mod/**", "effect": "deny" },

    { "action": "shell", "resource": "*", "effect": "ask" },

    // Allowed system utils
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "uniq *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "touch *", "effect": "allow" },

    // Blacklist
    { "action": "shell", "resource": "npx", "effect": "deny" },
    { "action": "shell", "resource": "npm", "effect": "deny" },
    { "action": "shell", "resource": "python*", "effect": "deny" },
    { "action": "shell", "resource": "node", "effect": "deny" },

    // Git
    { "action": "shell", "resource": "git *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false,
        "headers": {
          "CONTEXT7_API_KEY": "ctx7sk-e42c7077-c982-4ff9-bb3b-28a4295aec2f"
        }
      }
    }
  }
}
