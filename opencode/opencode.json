{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "permission": {
    "external_directory": {
      "~/go/pkg/mod/**": "allow"
    },
    "edit": {
      "~/go/pkg/mod/**": "deny"
    },

    "bash": {
      "*": "ask",

      // Allowed system utils
      "grep": "allow",
      "sort": "allow",
      "head": "allow",
      "uniq": "allow",
      "wc": "allow",
      "ls": "allow",

      // Blacklist
      "npx": "deny",
      "npm": "deny",
      "python*": "deny",

      // Git
      "git status *": "allow",
      "git branch -a": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git grep *": "allow",
      "git commit *": "allow",
      "git tag -l*": "allow",
      "git show *": "allow",
      "git ls-remote *": "allow"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
    }
  }
}
